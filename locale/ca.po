msgctxt "model:ir.model.button,string:button_synchronize_files"
msgid "Synchronize Files"
msgstr "Sincronitza els fitxers"

msgctxt "model:ir.message,text:msg_conflict_description"
msgid "The older version was renamed at \"%(path)s\". Resolve the conflict and remove the unwanted version."
msgstr "La versió més antiga s'ha reanomenat a \"%(path)s\". Resoleu el conflicte i suprimiu la versió no desitjada."

msgctxt "model:ir.message,text:msg_conflict_label"
msgid "File synchronization conflict"
msgstr "Conflicte de sincronització de fitxers"

msgctxt "model:ir.message,text:msg_invalid_filename"
msgid "\"%(name)s\" is not a safe file or directory name."
msgstr "\"%(name)s\" no és un nom de fitxer o directori segur."

msgctxt "model:ir.message,text:msg_markdown_utf8"
msgid "The Markdown file \"%(path)s\" is not valid UTF-8."
msgstr "El fitxer Markdown \"%(path)s\" no és UTF-8 vàlid."

msgctxt "model:ir.message,text:msg_path_required"
msgid "The [file_sync] path setting is required."
msgstr "Cal configurar el paràmetre path de [file_sync]."

msgctxt "view:office.category:"
msgid "Synchronize Files"
msgstr "Sincronitza els fitxers"
