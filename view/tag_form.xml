<?xml version="1.0"?>
<data>
    <xpath expr="/form/group[@id='checkboxes']/field[@name='active']"
            position="after">
        <label name="sync"/>
        <field name="sync"/>
        <button name="synchronize_files" string="Synchronize Files"/>
    </xpath>
    <xpath expr="/form/field[@name='description']" position="after">
        <notebook colspan="6">
            <page string="File Access" id="file_access" col="2">
                <field name="read_write_groups"/>
                <field name="read_only_groups"/>
                <field name="read_write_users"/>
                <field name="read_only_users"/>
            </page>
            <page string="Attachments" id="file_sync_attachments" col="1">
                <field name="attachments"/>
            </page>
        </notebook>
    </xpath>
</data>
